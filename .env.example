# Local PostgreSQL. Keep DATABASE_URL in sync with these values.
POSTGRES_USER=webbuilder
POSTGRES_PASSWORD=webbuilder-local
POSTGRES_DB=webbuilder
DATABASE_URL=postgresql://webbuilder:webbuilder-local@localhost:5432/webbuilder
# Backend credentials. Keep actual values in the ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional visual inspection requires an image-capable Responses API model.
PREVIEW_SCREENSHOTS_ENABLED=true
E2B_API_KEY=
# Must include the browser tools from sandbox/Dockerfile.
# Legacy starter; for new releases use the exact name:build-UUID from sandbox/template.py.
E2B_TEMPLATE_ID=dwel3q1jkunk4chqfw7h
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# A sandbox holds a live slot for 30 min of running time, then the provider parks
# it for free; preview traffic wakes it again.
MAX_CONCURRENT_RUNS=2
MAX_LIVE_SANDBOXES=2
# Delete retained paused runtimes after this many inactive days. Saved ZIPs remain.
PAUSED_SANDBOX_RETENTION_DAYS=7
# Bump to discard old retained environments after a runtime/template configuration change.
E2B_RUNTIME_GENERATION=1
RUN_TIMEOUT_SECONDS=600
RUN_MAX_TURNS=16
RUN_MAX_TOOL_CALLS=32
# Total input and output tokens across all model calls in one run.
RUN_MAX_TOKENS=200000
# Additional shared cost limits for verified free users; UTC calendar resets.
FREE_DAILY_COST_USD=0.20
FREE_MONTHLY_COST_USD=2.00
# USD per million tokens. Update the entire rate set when changing the model.
COST_MODEL=gpt-5.6-luna
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_CACHED_INPUT_USD_PER_MILLION=0.02
MODEL_CACHE_WRITE_USD_PER_MILLION=0.25
MODEL_OUTPUT_USD_PER_MILLION=1.20
# Resource ceiling must cover ALL current and saved-project E2B templates.
E2B_COST_MAX_CPU=2
E2B_COST_MAX_MEMORY_MB=4096
E2B_CPU_USD_PER_SECOND=0.000014
E2B_GIB_USD_PER_SECOND=0.0000045
# History retrieval is enabled. Keep automatic summaries off until quality evaluation.
MEMORY_COMPACTION_ENABLED=false

# Account authentication. See docs/auth-setup.md. Keep credentials server-side.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Local object storage. Generate a private password in the ignored .env.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=webbuilder-local
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=webbuilder-local
MINIO_SECRET_KEY=
STORAGE_DAILY_UPLOAD_MB=256
STORAGE_DAILY_DOWNLOAD_MB=1024
