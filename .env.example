# Local PostgreSQL. Keep DATABASE_URL in sync with these values.
POSTGRES_USER=webbuilder
POSTGRES_PASSWORD=webbuilder-local
POSTGRES_DB=webbuilder
DATABASE_URL=postgresql://webbuilder:webbuilder-local@localhost:5432/webbuilder
# Backend credentials. Keep actual values in the ignored .env file.
OPENAI_API_KEY=
# A registry id from agent/routing/models.toml. Only its provider's key is required.
DEFAULT_MODEL=gemini-3.8-flash
# Needs a DEFAULT_MODEL with attachment = true; boot fails otherwise.
PREVIEW_SCREENSHOTS_ENABLED=true
E2B_API_KEY=
# TypeSafe Jev (router and stack choice). Name read by the TypeSafe SDKs.
TYPESAFE_API_KEY=
# Model providers. Names are the ones each provider's SDK reads.
GEMINI_API_KEY=
# OpenRouter: development only, free (:free) models.
OPENROUTER_API_KEY=
# Vercel AI Gateway: organization key. Defined but not used by any code yet.
AI_GATEWAY_API_KEY=
# Must include the browser tools from sandbox/Dockerfile.
# Legacy starter; for new releases use the exact name:build-UUID from sandbox/template.py.
# The template as name:tag; `make template-build` moves the tag to each new build.
E2B_TEMPLATE=accretion:production
# The kit a new project starts from: vite-fastapi-postgres, next-postgres or vite-express-mongo.
DEFAULT_KIT=vite-fastapi-postgres
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# A sandbox holds a live slot for 30 min of running time, then the provider parks
# it for free; preview traffic wakes it again.
MAX_CONCURRENT_RUNS=18
MAX_LIVE_SANDBOXES=18
# Delete retained paused runtimes after this many inactive days. Saved ZIPs remain.
PAUSED_SANDBOX_RETENTION_DAYS=7
# Bump to discard old retained environments after a runtime/template configuration change.
E2B_RUNTIME_GENERATION=1
RUN_TIMEOUT_SECONDS=600
# Runaway backstops, not work limits. Compaction keeps a long run affordable;
# a low turn count would end healthy work before the cost ceiling ever applied.
RUN_MAX_TURNS=500
RUN_MAX_TOOL_CALLS=1000
# Compaction fires at the run's model window (agent/routing/models.toml) minus this
# reserve, capped at 400k's share of a 1.05M window so small-window models still compact.
COMPACTION_RESERVE_TOKENS=400000
# Router (spec 4.1). false = shadow: Auto runs on DEFAULT_MODEL and Jev's pick is only logged.
ROUTER_LIVE=false
# Dollars across all model calls in one run, compaction included.
RUN_MAX_COST_USD=1.00
# Additional shared cost limits for verified free users; UTC calendar resets.
FREE_DAILY_COST_USD=0.20
FREE_MONTHLY_COST_USD=2.00
# Resource ceiling must cover ALL current and saved-project E2B templates.
E2B_COST_MAX_CPU=2
E2B_COST_MAX_MEMORY_MB=4096
E2B_CPU_USD_PER_SECOND=0.000014
E2B_GIB_USD_PER_SECOND=0.0000045

# Account authentication. See docs/auth-setup.md. Keep credentials server-side.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Local object storage. Generate a private password in the ignored .env.
STORAGE_PROVIDER=minio
STORAGE_BUCKET=webbuilder-local
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=webbuilder-local
MINIO_SECRET_KEY=
STORAGE_DAILY_UPLOAD_MB=256
STORAGE_DAILY_DOWNLOAD_MB=1024
