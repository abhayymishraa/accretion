DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Set false if OPENAI_MODEL does not support image input.
PREVIEW_SCREENSHOTS_ENABLED=true
E2B_API_KEY=
# Exact template-name:build-UUID from sandbox/template.py (legacy IDs also work).
E2B_TEMPLATE_ID=
MAX_CONCURRENT_RUNS=2
MAX_LIVE_SANDBOXES=2
PREVIEW_IDLE_SECONDS=300
# Delete retained paused runtimes after this many inactive days. Saved ZIPs remain.
PAUSED_SANDBOX_RETENTION_DAYS=7
# Bump to discard old retained environments after a runtime/template configuration change.
E2B_RUNTIME_GENERATION=1
RUN_TIMEOUT_SECONDS=600
RUN_MAX_TURNS=16
RUN_MAX_TOOL_CALLS=32
# Total input and output tokens across all model calls in one run. Re-sent context
# is counted again each turn, so this grows far faster than the spend behind it.
RUN_MAX_TOKENS=1000000
# Per-user circuit breakers, not an allowance. Sized so credits bind first.
FREE_DAILY_COST_USD=8.00
FREE_MONTHLY_COST_USD=8.00
# Total monthly spend across every metered account. 0 disables the ceiling.
# The only limit that bounds spend as the number of users grows.
FREE_TIER_MONTHLY_BUDGET_USD=50.00
# Keep this rate set matched to OPENAI_MODEL; USD per million tokens.
COST_MODEL=gpt-5.6-luna
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_CACHED_INPUT_USD_PER_MILLION=0.02
MODEL_CACHE_WRITE_USD_PER_MILLION=0.25
MODEL_OUTPUT_USD_PER_MILLION=1.20
# Must cover ALL current and saved-project templates before enabling a release.
E2B_COST_MAX_CPU=2
E2B_COST_MAX_MEMORY_MB=4096
E2B_CPU_USD_PER_SECOND=0.000014
E2B_GIB_USD_PER_SECOND=0.0000045
SECRET_KEY=
ALLOWED_ORIGINS=https://webbuilder.abhayymishraa.us

# Authentication: set these to the deployed frontend/backend origins.
FRONTEND_URL=https://webbuilder.abhayymishraa.us
PUBLIC_API_URL=https://webbuilder-api.abhayymishraa.us
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Private production bucket; scoped service-account JSON is mounted read-only.
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
STORAGE_DAILY_UPLOAD_MB=256
STORAGE_DAILY_DOWNLOAD_MB=1024
