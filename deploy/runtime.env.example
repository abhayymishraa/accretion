DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Claude models (agent/routing/models.toml, provider anthropic). Out of Auto until set.
ANTHROPIC_API_KEY=
# TypeSafe Jev, the router. Without it Auto falls back to DEFAULT_MODEL.
TYPESAFE_API_KEY=
# Only DEFAULT_MODEL's provider needs a key. A registry id from agent/routing/models.toml.
DEFAULT_MODEL=gemini-3.8-flash
# Needs a DEFAULT_MODEL with attachment = true; boot fails otherwise.
E2B_API_KEY=
# The template as name:tag; `make template-build` moves the tag to each new build.
E2B_TEMPLATE=accretion:production
# The kit a new project starts from: vite-fastapi-postgres, next-postgres or vite-express-mongo.
DEFAULT_KIT=vite-fastapi-postgres
# Service-wide, not per user, and both draw on the same sandbox pool: a run and
# its preview share one sandbox per chat, so MAX_LIVE_SANDBOXES is the real cap.
# E2B Hobby allows 20 concurrent; paused sandboxes do not count toward it.
# A sandbox holds a live slot for 30 min of running time, then the provider parks
# it for free; preview traffic wakes it again.
MAX_CONCURRENT_RUNS=18
MAX_LIVE_SANDBOXES=18
# Delete retained paused runtimes after this many inactive days. Saved ZIPs remain.
PAUSED_SANDBOX_RETENTION_DAYS=7
# Bump to discard old retained environments after a runtime/template configuration change.
E2B_RUNTIME_GENERATION=1
# Runaway backstops, not work limits. Compaction keeps a long run affordable;
# a low turn count would end healthy work before the cost ceiling ever applied.
RUN_MAX_TURNS=500
RUN_MAX_TOOL_CALLS=1000
# Compaction fires at the run's model window (agent/routing/models.toml) minus this
# reserve, capped at 400k's share of a 1.05M window so small-window models still compact.
COMPACTION_RESERVE_TOKENS=400000
# Router (spec 4.1). false = shadow: Auto runs on DEFAULT_MODEL and Jev's pick is only logged.
ROUTER_LIVE=false
# Model spend per user per UTC month, the only usage limit. Sandbox time does not count.
MONTHLY_BUDGET_USD=4.00
# Must cover ALL current and saved-project templates before enabling a release.
E2B_COST_MAX_CPU=2
E2B_COST_MAX_MEMORY_MB=4096
E2B_CPU_USD_PER_SECOND=0.000014
E2B_GIB_USD_PER_SECOND=0.0000045
SECRET_KEY=
ALLOWED_ORIGINS=https://accretion.abhayymishraa.com

# Authentication: set these to the deployed frontend/backend origins.
FRONTEND_URL=https://accretion.abhayymishraa.com
PUBLIC_API_URL=https://api.accretion.abhayymishraa.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Private production bucket; scoped service-account JSON is mounted read-only.
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
STORAGE_DAILY_UPLOAD_MB=256
STORAGE_DAILY_DOWNLOAD_MB=1024
# Redis runs in deploy/compose.yaml on the same VM.
REDIS_URL=redis://redis:6379/0
# Optional platform keys for connected services that work without one. Every build calls
# from this VM, so without a key all users share the service's low anonymous rate limit.
# A key a user saves on the service's page replaces these.
CONTEXT7_API_KEY=
HF_TOKEN=
