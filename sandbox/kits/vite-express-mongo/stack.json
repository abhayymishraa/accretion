{
  "id": "vite-express-mongo",
  "name": "React + Express + MongoDB",
  "database": "mongo",
  "services": [
    {"name": "api", "cwd": "backend", "start": "node node_modules/tsx/dist/cli.mjs watch src/index.ts", "port": 4000, "ready": "/api/health"},
    {"name": "web", "cwd": "frontend", "start": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5173 --strictPort", "port": 5173, "ready": "/"}
  ],
  "preview_port": 5173,
  "install": "cd frontend && npm ci --ignore-scripts && cd ../backend && npm ci --ignore-scripts",
  "build": "cd frontend && npm run build && cd ../backend && npm run typecheck",
  "typecheck": "cd frontend && npm run typecheck && cd ../backend && npm run typecheck",
  "migrate": "cd backend && npm run migrate",
  "seed": "",
  "dump": "mongodump --uri \"$MONGO_URL\" --archive=db/dump.archive --quiet",
  "restore": "mongorestore --uri \"$MONGO_URL\" --archive=db/dump.archive --drop --quiet",
  "migrations": ["backend/src/db.ts"],
  "env": ["APP_SECRET"],
  "entry": ["AGENTS.md", "frontend/src/App.tsx", "backend/src/index.ts", "backend/src/routes/notes.ts"]
}
