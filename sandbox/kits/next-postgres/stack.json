{
  "id": "next-postgres",
  "name": "Next.js + Postgres",
  "database": "postgres",
  "services": [{"name": "web", "cwd": ".", "start": "node node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3000", "port": 3000, "ready": "/api/health"}],
  "preview_port": 3000,
  "install": "npm ci --ignore-scripts",
  "build": "npm run build",
  "typecheck": "npm run typecheck",
  "migrate": "npm run migrate",
  "seed": "",
  "dump": "pg_dump --clean --if-exists --no-owner \"$DATABASE_URL\" > db/dump.sql",
  "restore": "psql \"$DATABASE_URL\" -q -f db/dump.sql",
  "migrations": ["drizzle/"],
  "env": ["POSTGRES_PASSWORD", "APP_SECRET"],
  "entry": ["AGENTS.md", "app/page.tsx", "app/api/notes/route.ts", "db/schema.ts"]
}
