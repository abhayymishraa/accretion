{
  "id": "vite-express-postgres",
  "name": "React + Express + Postgres",
  "database": "postgres",
  "services": [
    {"name": "api", "cwd": "backend", "start": "node node_modules/tsx/dist/cli.mjs watch src/index.ts", "port": 4000, "ready": "/api/health"},
    {"name": "web", "cwd": "frontend", "start": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5173 --strictPort", "port": 5173, "ready": "/"}
  ],
  "preview_port": 5173,
  "install": "cd frontend && npm ci --ignore-scripts && cd ../backend && npm ci --ignore-scripts",
  "build": "cd frontend && npm run build",
  "typecheck": "cd frontend && npm run typecheck && cd ../backend && npm run typecheck",
  "migrate": "cd backend && npm run migrate",
  "seed": "",
  "dump": "pg_dump --clean --if-exists --no-owner \"$DATABASE_URL\" > db/dump.sql",
  "restore": "psql \"$DATABASE_URL\" -q -f db/dump.sql",
  "migrations": ["backend/drizzle/"],
  "env": ["POSTGRES_PASSWORD", "APP_SECRET"],
  "entry": ["AGENTS.md", "frontend/src/App.tsx", "backend/src/index.ts", "backend/src/routes/notes.ts", "backend/src/db/schema.ts"]
}
